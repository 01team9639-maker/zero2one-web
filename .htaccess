# ================================================================
#  ZERO 2 ONE — performance & caching (.htaccess)
#  Works on Hostinger (Apache / LiteSpeed). Safe defaults.
# ================================================================

# ----------------------------------------------------------------
#  0) Canonical URLs
#     a) /index.html            -> /            (any directory)
#     b) /pages/projects/x.html -> /services/…/ (July 2026 URL move)
#
#     The 301s in (b) are what carries the indexing and any existing
#     backlinks over to the new service URLs — they must stay in place
#     permanently, not just until Search Console catches up.
# ----------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # a) drop a trailing index.html from any directory URL
    RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]*/)?index\.html[\s?]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

    # b) retired URLs -> their replacements
    # >>> BEGIN generated redirects — tools/build_redirects.py (do not edit by hand)
    # Source: tools/redirects.json — regenerate with tools/build_redirects.py
    # These are permanent. Each one carries the ranking of a retired URL.
    RewriteRule ^pages/projects/website-design\.html$   /services/web-design-riyadh/           [R=301,L]
    RewriteRule ^pages/projects/seo\.html$              /services/seo-riyadh/                  [R=301,L]
    RewriteRule ^pages/projects/advertising\.html$      /services/digital-advertising/         [R=301,L]
    RewriteRule ^pages/projects/brand-identity\.html$   /services/brand-identity/              [R=301,L]
    RewriteRule ^pages/projects/social-media\.html$     /services/social-media-management/     [R=301,L]
    RewriteRule ^pages/projects/ecommerce\.html$        /services/ecommerce-development/       [R=301,L]
    RewriteRule ^pages/projects/$                       /services/                             [R=301,L]
    RewriteRule ^pages/$                                /services/                             [R=301,L]
    # <<< END generated redirects

    # c) add the missing trailing slash on real directories, so /services/seo-riyadh
    #    and /services/seo-riyadh/ do not become two indexable URLs
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ----------------------------------------------------------------
#  1) GZIP / DEFLATE compression  (shrinks CSS, JS, HTML, SVG, fonts)
# ----------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE font/otf font/ttf application/font-sfnt
</IfModule>

# ----------------------------------------------------------------
#  2) Brotli compression (if the server supports it — even smaller)
# ----------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ----------------------------------------------------------------
#  3) Browser caching  (fixes "inefficient cache lifetimes")
# ----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Images & video — 1 year
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType video/mp4                 "access plus 1 year"

    # Fonts — 1 year
    ExpiresByType font/otf                  "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType application/font-sfnt     "access plus 1 year"

    # CSS & JS — 1 day (updates reach visitors within 24h automatically;
    #   bump the ?v= stamp for an instant, global update when needed)
    ExpiresByType text/css                  "access plus 1 day"
    ExpiresByType application/javascript    "access plus 1 day"
    ExpiresByType text/javascript           "access plus 1 day"

    # HTML — must revalidate (so content updates show immediately)
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# Long-lived, immutable cache for static assets (belt & suspenders)
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|otf|ttf|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
